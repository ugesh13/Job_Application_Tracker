# Database Configuration (Neon PostgreSQL)
DATABASE_URL="postgresql://user:password@endpoint.us-east-2.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@endpoint.us-east-2.aws.neon.tech/neondb?sslmode=require"
NEON_BRANCH=production

# Firebase Authentication & Configuration
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-app"
VITE_FIREBASE_STORAGE_BUCKET="your-app.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
FIREBASE_PROJECT_ID="your-app"

# Optional AI Key (for enhanced generative insights)
GEMINI_API_KEY="your-gemini-api-key"
